# Copy this file to .env and adjust as needed. Every value below has a sane
# default if left unset — you only need to fill in what your setup requires.

# Port the server listens on. Defaults to 8443. Pick anything >1024 so you
# don't need root/setcap to bind it. Change this if it collides with
# something else on your machine, or your school network blocks it.
PORT=8443

# Where the SQLite database file lives. Defaults to ./data/classroom.sqlite3
# (created automatically on first run).
DB_PATH=./data/classroom.sqlite3

# Which frontend origin(s) may call this API. "*" (default) allows any
# origin, which is fine since this API uses bearer tokens, not cookies.
# Set this to your GitHub Pages origin (e.g. https://yourname.github.io) if
# you want to lock it down.
CORS_ORIGIN=*

# Secret used to sign login tokens. Leave blank and one will be generated
# for you on first run and saved to data/secret.key. Only set this yourself
# if you need multiple server processes to share the same signing key.
JWT_SECRET=

# --- TLS: bring your own certificate (recommended if you have one) ---
# If you have a real certificate (e.g. from Let's Encrypt/certbot, or issued
# by your school), point these at the cert and private key files and the
# server will use them directly — students won't see any "untrusted
# certificate" warning when connecting.
# Leave both blank to fall back to an auto-generated self-signed certificate
# (the app will walk you and your students through trusting it once).
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional: once your first teacher account exists, new teacher signups are
# blocked unless this code is supplied. Leave blank to allow open teacher
# signup only until the first teacher registers (recommended for solo use).
TEACHER_SIGNUP_CODE=
